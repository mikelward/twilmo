<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Signaling and media once calls land; connectivity checks at call time.
         The manifest grows with the milestone that exercises each entry (SPEC
         "Permissions and roles"), so these two install-time permissions are
         all the scaffold declares. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Calls run over the network, not the cellular radio, so Twilmo installs
         on radio-less devices too; a phone is still the product's home. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="${launcherIcon}"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.Twilmo">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
